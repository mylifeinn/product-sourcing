# Copy to .env and fill in your credentials
# Never commit .env to git!

# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxx
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxx

# Keepa API (免费注册 https://keepa.com/#!api，每天 100 token)
KEEPA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Patents (optional, for compliance)
GOOGLE_PATENTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# USPTO (optional)
USPTO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rainforest API (optional, Amazon 数据)
RAINFOREST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DataForSEO (optional, 关键词搜索量/KD)
DATAFORSEO_LOGIN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATAFORSEO_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ahrefs (for keyword data)
AHREFS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Patents (optional, for compliance)
GOOGLE_PATENTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# USPTO (optional)
USPTO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TikTok Creative Center (no official API, uses playwright scraper)
# No token needed

# 1688/Alibaba (no official API, uses playwright scraper)
# No token needed